{
  "name": "@foundry/adapter-api",
  "version": "0.1.0",
  "private": true,
  "description": "Foundry L1 execution-adapter contract: ExecutionAdapter, RunSpec, EngineEvent, CapabilitySet, and the shared conformance suite (describeAdapterContract). No engine I/O.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@foundry/core": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
