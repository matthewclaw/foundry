{
  "name": "@foundry/server",
  "version": "0.1.0",
  "private": true,
  "description": "Foundry L3 control-plane server: HTTP+SSE API, context composition, startup orchestration. Depends: core, store, runtime.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@foundry/core": "workspace:*",
    "@foundry/runtime": "workspace:*",
    "@foundry/store": "workspace:*",
    "fastify": "^4.28.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@foundry/adapter-fake": "workspace:*",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
