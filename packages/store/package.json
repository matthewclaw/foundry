{
  "name": "@foundry/store",
  "version": "0.1.0",
  "private": true,
  "description": "Foundry L1 store: SQLite (WAL), migrations, atomic mutate(), entity queries, event feed, projections. Depends: core, better-sqlite3.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@foundry/core": "workspace:*",
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
