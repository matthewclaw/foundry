{
  "name": "@foundry/core",
  "version": "0.1.0",
  "private": true,
  "description": "Foundry L0 domain package: entity types, Zod schemas, event catalogue, ids, state machines. No I/O.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "fast-check": "^3.22.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "zod-to-json-schema": "^3.23.5"
  }
}
